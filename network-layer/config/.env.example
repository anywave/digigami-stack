# DIGIGAMI Network Guardian Configuration

# Network identification
NETWORK_ID=your-network-id-here

# Host IP (where block page is served)
HOST_IP=192.168.1.1

# Upstream DNS server
DIGIGAMI_UPSTREAM_DNS=8.8.8.8

# Cloud API endpoint
DIGIGAMI_CLOUD_API=https://api.digigami.ai/v1

# Sync interval in seconds
DIGIGAMI_SYNC_INTERVAL=30
